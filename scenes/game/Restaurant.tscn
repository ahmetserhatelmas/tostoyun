theme_override_font_sizes/font_size = 20
text = "Müşteri camda bekler, istediği tostu gösterir.

1) Soldaki ekmek kasasına bas, tut, sürükle
2) Izgaraya bırak (en fazla 2)
3) 10 saniye kızarsın, sonra ızgaradan al
4) Çok beklersen kapkara yanar, çöpe at
5) Tostu ortadaki kesme tahtasına koy
6) Kaşar, sucuk veya sosu üstüne bırak
7) Pencereki müşteriye ver
Doğruysa güler, yanlışsa üzülür

İçecekler dolapta: kola, ayran, su."
autowrap_mode = 3

